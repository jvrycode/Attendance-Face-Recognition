# Cloudflare Pages response headers (applies to the deployed site only; `npm run dev` ignores it).
# Content-Security-Policy: the browser only runs/loads code and data from the sources listed.
# An injected script from anywhere else is blocked, so it cannot read the login tokens.
#
#   script-src   own bundle + face-api overlay library on jsDelivr (no inline or eval'd code)
#   style-src    own CSS + Google Fonts CSS; 'unsafe-inline' only because React uses style={...}
#   connect-src  Django API on Render, face-api model files, PSGC address lookup
#   img-src      own files, API (signed face photos), Cloudinary (profile images), avatar placeholders
#
# If the API moves, update https://attendance-face-recognition-1.onrender.com below.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://attendance-face-recognition-1.onrender.com https://res.cloudinary.com https://ui-avatars.com; connect-src 'self' https://attendance-face-recognition-1.onrender.com https://cdn.jsdelivr.net https://psgc.gitlab.io; media-src 'self' blob: mediastream:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
